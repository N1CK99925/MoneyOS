# Razorpay test-mode credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Database — Neon Postgres (connection string from Neon dashboard)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Audit
AUDIT_HMAC_SECRET=change-this-to-a-random-string

# App settings
APP_ENV=development
DEBUG=true

# LLM (for buyer agent — set your provider's API key)
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=sk-...
LLM_FALLBACK_MODELS=groq/llama-3.3-70b-versatile,gemini/gemini-2.0-flash
LLM_MAX_ITERATIONS=10

# Service URL (where the merchant agent runs)
SERVICE_URL=http://localhost:8000

# Telegram — mobile delivery of payment links & approval cards (optional).
# Get the bot token from @BotFather. Set the merchant chat ID to your Telegram
# chat ID to receive Approve/Deny buttons on your phone.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_MERCHANT_CHAT_ID=123456789
# TELEGRAM_CUSTOMER_CHAT_ID=   # blank = same as merchant

# Tavily Search (for Phase 4B stretch agent — get free key at https://tavily.com/)
TAVILY_API_KEY=tvly-...
